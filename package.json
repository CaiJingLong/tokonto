{
  "name": "token-usage",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Local, AI-first token usage and time-aware pricing dashboard",
  "type": "module",
  "private": true,
  "bin": {
    "token-usage": "src/cli.ts"
  },
  "scripts": {
    "start": "bun src/cli.ts server",
    "dev": "bun --watch src/cli.ts server",
    "cli": "bun src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun scripts/build.ts",
    "release:pack": "bun scripts/release.ts",
    "release:smoke": "bun scripts/smoke-release.ts"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "luxon": "^3.7.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/luxon": "^3.7.5",
    "typescript": "^7.0.2"
  }
