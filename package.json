{
  "name": "tokonto",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Local, AI-first token usage and time-aware pricing dashboard",
  "repository": { "type": "git", "url": "git+https://github.com/CaiJingLong/tokonto.git" },
  "homepage": "https://github.com/CaiJingLong/tokonto#readme",
  "bugs": { "url": "https://github.com/CaiJingLong/tokonto/issues" },
  "type": "module",
  "bin": {
    "tokonto": "dist/cli.js"
  },
  "files": ["dist/", "docs/", "examples/", ".agents/skills/tokonto/", "CHANGELOG.md", "CONTRIBUTING.md", "SECURITY.md"],
  "keywords": ["ai", "tokens", "usage", "cost", "cli", "dashboard", "pricing"],
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "scripts": {
    "start": "bun src/cli.ts server",
    "dev": "bun --watch src/cli.ts server",
    "cli": "bun src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun scripts/build.ts",
    "prepack": "bun run build",
    "npm:pack": "bun scripts/npm-pack.ts",
    "npm:smoke": "bun scripts/smoke-release.ts --npm",
    "release:pack": "bun scripts/release.ts",
    "release:smoke": "bun scripts/smoke-release.ts"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "devDependencies": {
    "decimal.js": "^10.6.0",
    "luxon": "^3.7.2",
    "zod": "^4.6.5",
    "@types/bun": "^1.4.2",
    "@types/luxon": "^3.7.5",
    "typescript": "^7.0.2"
  }
}
